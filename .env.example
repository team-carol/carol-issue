# ── 서버 ──────────────────────────────────────────────
PORT=3000
BASE_URL=http://localhost:3000

# ── GitHub App (필수) ─────────────────────────────────
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# owner/repo 형식. 예: team-carol/carol
GITHUB_REPOSITORY=team-carol/carol

# ── GitHub App private key (둘 중 하나) ────────────────
# inline PEM (개행은 \n)
GITHUB_PRIVATE_KEY=
# 또는 파일 경로
GITHUB_PRIVATE_KEY_FILE=

# ── AI Provider (필수) ────────────────────────────────
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# OpenAI-compatible 엔드포인트 교체용 (선택)
AI_BASE_URL=

# ── carol 봇 연동 인증 (필수) ─────────────────────────
CAROL_SHARED_SECRET=

# ── 인증 허용 목록 (선택, 콤마 구분) ──────────────────
CAROL_ALLOWED_CLIENT_IDS=
CAROL_ALLOWED_GUILD_IDS=
# 서명 TTL(초). 설정 시 요청 서명 유효기간 검증 (선택)
CAROL_SIGNATURE_TTL_SECONDS=

# ── Cloudflare Tunnel (운영 배포용) ───────────────────
CF_TUNNEL_TOKEN=

# ── 하위호환 (GITHUB_REPOSITORY 없을 때만) ────────────
# GITHUB_OWNER=
# GITHUB_REPO=
